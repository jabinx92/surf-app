{
  "expo": {
    "name": "WaveLens",
    "slug": "wavelens",
    "description": "Book trusted surf photographers and videographers near your favorite breaks.",
    "version": "1.0.0",
    "backgroundColor": "#061827",
    "orientation": "portrait",
    "icon": "./assets/images/wavelens-icon.png",
    "scheme": "wavelens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.johnnywon.wavelens",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061827",
        "foregroundImage": "./assets/images/wavelens-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/wavelens-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WaveLens uses your location to show surf spots and creators near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WaveLens uses the photos and videos you choose for your profile and creator portfolio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wavelens-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#061827",
          "dark": {
            "backgroundColor": "#061827"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#56d6c9",
          "defaultChannel": "booking-reminders"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1457ce5-680d-4586-b306-b4b23a3f780b"
      }
    },
    "owner": "jabinx92"
  }
}

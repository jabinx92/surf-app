{
  "expo": {
    "name": "WaveLens",
    "slug": "wavelens",
    "description": "Book trusted surf photographers and videographers near your favorite breaks.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wavelens-icon.png",
    "scheme": "wavelens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061827",
        "foregroundImage": "./assets/images/wavelens-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wavelens-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WaveLens uses your location to show surf spots and creators near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/wavelens-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#061827",
          "dark": {
            "backgroundColor": "#061827"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
